# Ignore everything by default (safety: this repo is at your home folder)
*

# Keep this file
!.gitignore

# Track landing site files at repo root
!index.html
!privacy-policy.html
!delete-account.html
!vercel.json
!package.json

# Track website screenshot assets
!assets/
!assets/**

# Track PWA source
!pwa/
!pwa/**

# Track built PWA output (run: cd pwa && npm run build)
!app/
!app/**

# Ignore PWA dependencies and secrets
pwa/node_modules/
pwa/dist/
pwa/.env
